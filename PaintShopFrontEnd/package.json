{
  "name": "paint-shop-front-end",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "serve -s dist/browser -l $PORT",
    "build": "ng build --output-path dist",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.4",
    "daisyui": "^5.7.50",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.4",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  }
}
